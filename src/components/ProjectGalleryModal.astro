---
import { getContent, tr, type Lang } from '../i18n/ui';
import { projects } from '../data/projects';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getContent(lang);

// Solo proyectos que tienen screenshots configurados
const galleryProjects = projects
  .filter((p) => p.screenshots && p.screenshots.length > 0)
  .map((p) => ({
    slug: p.slug,
    title: tr(p.title, lang),
    repoUrl: p.repoUrl || p.url,
    screenshots: (p.screenshots || []).map((s) => ({
      src: s.src,
      title: tr(s.title, lang),
      desc: s.desc ? tr(s.desc, lang) : '',
    })),
  }));
---

<dialog id="project-gallery-dialog" class="gallery-dialog" aria-modal="true" aria-labelledby="gallery-active-title">
  <div class="gallery-window">
    <!-- Barra superior -->
    <header class="gallery-header">
      <div class="gallery-header-info">
        <span class="gallery-badge">DEMO & CAPTURAS</span>
        <h2 id="gallery-project-title" class="gallery-project-title">ProdeOptica</h2>
      </div>

      <div class="gallery-header-actions">
        <span id="gallery-counter" class="gallery-counter">01 / 10</span>
        <a id="gallery-repo-link" href="#" target="_blank" rel="noopener noreferrer" class="gallery-btn-repo" title={t.project_repo}>
          <span>GitHub ↗</span>
        </a>
        <button type="button" id="gallery-close-btn" class="gallery-btn-close" aria-label={t.gallery_close} title={t.gallery_close}>
          ✕
        </button>
      </div>
    </header>

    <!-- Escenario Principal -->
    <div class="gallery-stage">
      <button type="button" id="gallery-prev-btn" class="gallery-nav-btn prev" aria-label={t.gallery_prev} title={t.gallery_prev}>
        ←
      </button>

      <div class="gallery-image-viewport">
        <img id="gallery-active-img" src="" alt="" loading="eager" />
      </div>

      <button type="button" id="gallery-next-btn" class="gallery-nav-btn next" aria-label={t.gallery_next} title={t.gallery_next}>
        →
      </button>
    </div>

    <!-- Descripción / Información de la Captura -->
    <div class="gallery-caption-box">
      <h3 id="gallery-active-title" class="gallery-active-title"></h3>
      <p id="gallery-active-desc" class="gallery-active-desc"></p>
    </div>

    <!-- Tira de Miniaturas -->
    <div class="gallery-thumbs-container">
      <div id="gallery-thumbs-track" class="gallery-thumbs-track"></div>
    </div>
  </div>
</dialog>

<!-- Datos serializados de proyectos para el script cliente -->
<script id="gallery-data" type="application/json" set:html={JSON.stringify(galleryProjects)} />

<script>
  interface ScreenshotData {
    src: string;
    title: string;
    desc: string;
  }

  interface ProjectGalleryData {
    slug: string;
    title: string;
    repoUrl?: string;
    screenshots: ScreenshotData[];
  }

  const dialog = document.getElementById('project-gallery-dialog') as HTMLDialogElement | null;
  const dataScript = document.getElementById('gallery-data');

  if (dialog && dataScript) {
    const projects: ProjectGalleryData[] = JSON.parse(dataScript.textContent || '[]');
    const projectTitle = document.getElementById('gallery-project-title')!;
    const counter = document.getElementById('gallery-counter')!;
    const repoLink = document.getElementById('gallery-repo-link') as HTMLAnchorElement;
    const closeBtn = document.getElementById('gallery-close-btn')!;
    const prevBtn = document.getElementById('gallery-prev-btn')!;
    const nextBtn = document.getElementById('gallery-next-btn')!;
    const activeImg = document.getElementById('gallery-active-img') as HTMLImageElement;
    const activeTitle = document.getElementById('gallery-active-title')!;
    const activeDesc = document.getElementById('gallery-active-desc')!;
    const thumbsTrack = document.getElementById('gallery-thumbs-track')!;

    let currentProject: ProjectGalleryData | null = null;
    let currentIndex = 0;

    function renderSlide(index: number) {
      if (!currentProject || !currentProject.screenshots.length) return;
      currentIndex = (index + currentProject.screenshots.length) % currentProject.screenshots.length;
      const shot = currentProject.screenshots[currentIndex];

      activeImg.src = shot.src;
      activeImg.alt = shot.title;
      activeTitle.textContent = shot.title;
      activeDesc.textContent = shot.desc || '';

      const pad = (n: number) => String(n).padStart(2, '0');
      counter.textContent = `${pad(currentIndex + 1)} / ${pad(currentProject.screenshots.length)}`;

      // Actualizar miniatura activa
      const thumbs = thumbsTrack.querySelectorAll<HTMLButtonElement>('.gallery-thumb-btn');
      thumbs.forEach((thumb, i) => {
        const isActive = i === currentIndex;
        thumb.classList.toggle('active', isActive);
        thumb.setAttribute('aria-current', isActive ? 'true' : 'false');
        if (isActive) {
          thumb.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
        }
      });
    }

    function openGallery(slug: string) {
      const found = projects.find((p) => p.slug === slug);
      if (!found || !found.screenshots.length) return;

      currentProject = found;
      projectTitle.textContent = found.title;

      if (found.repoUrl) {
        repoLink.href = found.repoUrl;
        repoLink.style.display = 'inline-flex';
      } else {
        repoLink.style.display = 'none';
      }

      // Reconstruir miniaturas
      thumbsTrack.innerHTML = '';
      found.screenshots.forEach((s, idx) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'gallery-thumb-btn';
        btn.setAttribute('aria-label', s.title);
        btn.innerHTML = `<img src="${s.src}" alt="${s.title}" loading="lazy" />`;
        btn.addEventListener('click', () => renderSlide(idx));
        thumbsTrack.appendChild(btn);
      });

      renderSlide(0);
      dialog.showModal();
      document.body.style.overflow = 'hidden';
    }

    function closeGallery() {
      dialog.close();
      document.body.style.overflow = '';
    }

    // Navegación
    prevBtn.addEventListener('click', () => renderSlide(currentIndex - 1));
    nextBtn.addEventListener('click', () => renderSlide(currentIndex + 1));
    closeBtn.addEventListener('click', closeGallery);

    // Cierre al cliquear el backdrop fuera del marco
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) {
        closeGallery();
      }
    });

    // Soporte de teclado
    window.addEventListener('keydown', (e) => {
      if (!dialog.open) return;
      if (e.key === 'Escape') {
        closeGallery();
      } else if (e.key === 'ArrowLeft') {
        renderSlide(currentIndex - 1);
      } else if (e.key === 'ArrowRight') {
        renderSlide(currentIndex + 1);
      }
    });

    // Event listener global para botones con data-open-gallery="slug"
    document.querySelectorAll('[data-open-gallery]').forEach((trigger) => {
      trigger.addEventListener('click', (e) => {
        e.preventDefault();
        const slug = (trigger as HTMLElement).dataset.openGallery;
        if (slug) openGallery(slug);
      });
    });
  }
</script>

<style>
  .gallery-dialog {
    margin: auto;
    padding: 0;
    border: none;
    background: transparent;
    max-width: min(1180px, 94vw);
    width: 100%;
    color: var(--color-ink);
  }

  .gallery-dialog::backdrop {
    background: rgba(10, 10, 10, 0.88);
    backdrop-filter: blur(4px);
  }

  .gallery-window {
    display: flex;
    flex-direction: column;
    background: var(--color-cream);
    border: var(--border);
    box-shadow: 12px 12px 0 var(--color-ink);
    max-height: 92vh;
    overflow-y: auto;
  }

  /* Header */
  .gallery-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 16px 20px;
    background: var(--color-ink);
    color: var(--color-cream);
    border-bottom: var(--border);
  }

  .gallery-header-info {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .gallery-badge {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: #A78BFA;
  }

  .gallery-project-title {
    font-size: 18px;
    font-weight: 800;
    text-transform: uppercase;
    color: var(--color-cream);
    margin: 0;
  }

  .gallery-header-actions {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .gallery-counter {
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 700;
    background: #1F1F1F;
    color: #FAFAF5;
    padding: 6px 12px;
    border: 1px solid #333;
  }

  .gallery-btn-repo {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--color-ink);
    background: var(--color-cream);
    padding: 6px 12px;
    border: 2px solid var(--color-cream);
    transition: background 0.15s ease, transform 0.1s ease;
  }

  .gallery-btn-repo:hover {
    background: var(--color-accent);
    color: #FAFAF5;
    border-color: var(--color-accent);
  }

  .gallery-btn-close {
    font-family: var(--font-mono);
    font-size: 16px;
    font-weight: 800;
    background: #E11D48;
    color: #FFFFFF;
    border: 2px solid #FFFFFF;
    width: 34px;
    height: 34px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: opacity 0.15s ease, transform 0.1s ease;
  }

  .gallery-btn-close:hover {
    opacity: 0.9;
    transform: scale(1.05);
  }

  /* Stage principal */
  .gallery-stage {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: #111111;
    min-height: 360px;
    padding: 12px;
    border-bottom: var(--border);
  }

  .gallery-image-viewport {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    max-height: 58vh;
    overflow: hidden;
  }

  .gallery-image-viewport img {
    max-width: 100%;
    max-height: 58vh;
    width: auto;
    height: auto;
    object-fit: contain;
    border: 2px solid #222;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.6);
  }

  .gallery-nav-btn {
    font-family: var(--font-mono);
    font-size: 24px;
    font-weight: 800;
    background: var(--color-cream);
    color: var(--color-ink);
    border: var(--border-thin);
    box-shadow: 4px 4px 0 var(--color-ink);
    width: 44px;
    height: 52px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 5;
    transition: background 0.15s ease, transform 0.1s ease;
    margin: 0 10px;
    flex-shrink: 0;
  }

  .gallery-nav-btn:hover {
    background: var(--color-accent);
    color: var(--color-cream);
    transform: translateY(-2px);
  }

  .gallery-nav-btn:active {
    transform: translateY(1px);
    box-shadow: 2px 2px 0 var(--color-ink);
  }

  /* Descripción del slide */
  .gallery-caption-box {
    padding: 18px 24px;
    border-bottom: var(--border);
    background: var(--color-cream);
  }

  .gallery-active-title {
    font-family: var(--font-mono);
    font-size: 15px;
    font-weight: 800;
    text-transform: uppercase;
    color: var(--color-ink);
    margin-bottom: 6px;
  }

  .gallery-active-desc {
    font-size: 13.5px;
    font-weight: 500;
    line-height: 1.55;
    color: #333333;
  }

  /* Tira de Miniaturas */
  .gallery-thumbs-container {
    padding: 12px 18px;
    background: #EBEAE5;
    overflow-x: auto;
    scrollbar-width: thin;
  }

  .gallery-thumbs-track {
    display: flex;
    gap: 10px;
  }

  .gallery-thumb-btn {
    flex: 0 0 88px;
    height: 56px;
    padding: 0;
    border: 2px solid var(--color-ink);
    background: #111;
    overflow: hidden;
    cursor: pointer;
    opacity: 0.6;
    transition: opacity 0.15s ease, transform 0.15s ease, border-color 0.15s ease;
  }

  .gallery-thumb-btn img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .gallery-thumb-btn:hover {
    opacity: 0.9;
    transform: translateY(-2px);
  }

  .gallery-thumb-btn.active {
    opacity: 1;
    border: 3px solid var(--color-accent);
    box-shadow: 2px 2px 0 var(--color-ink);
    transform: translateY(-2px);
  }

  @media (max-width: 640px) {
    .gallery-stage {
      min-height: 240px;
      padding: 6px;
    }

    .gallery-nav-btn {
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      margin: 0;
      width: 36px;
      height: 44px;
      font-size: 18px;
      background: rgba(250, 250, 245, 0.9);
    }

    .gallery-nav-btn.prev {
      left: 8px;
    }

    .gallery-nav-btn.next {
      right: 8px;
    }

    .gallery-thumb-btn {
      flex: 0 0 68px;
      height: 44px;
    }
  }
</style>

