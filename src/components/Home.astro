---
import Preloader from './Preloader.astro';
import Nav from './Nav.astro';
import Ticker from './Ticker.astro';
import Hero from './Hero.astro';
import About from './About.astro';
import Focus from './Focus.astro';
import Lab from './Lab.astro';
import Projects from './Projects.astro';
import Journey from './Journey.astro';
import Contact from './Contact.astro';
import Footer from './Footer.astro';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<Preloader lang={lang} />
<Nav lang={lang} />
<Ticker lang={lang} />
<main>
  <Hero lang={lang} />
  <About lang={lang} />
  <Focus lang={lang} />
  <Lab lang={lang} />
  <Projects lang={lang} />
  <Journey lang={lang} />
  <Contact lang={lang} />
</main>
<Footer lang={lang} />
