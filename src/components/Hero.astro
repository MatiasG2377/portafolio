---
import { getContent, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getContent(lang);
---

<header id="hero" class="hero section">
  <div class="hero-text">
    <span class="hero-badge">{t.hero_badge}</span>

    <h1 class="hero-h1">
      <span class="line">{t.hero_l1}</span>
      <span class="line">{t.hero_l2}</span>
      <span class="line outline">{t.hero_l3}</span>
      <span class="line">{t.hero_l4}</span>
    </h1>

    <p class="hero-body">{t.hero_body}</p>

    <div class="hero-ctas">
      <a href="#projects" class="cta cta-primary">{t.cta_primary}</a>
      <a href="#journey" class="cta cta-secondary">{t.cta_secondary}</a>
    </div>
  </div>

  <div class="hero-graphic stripes">
    <span class="hero-graphic-caption">{t.hero_graph_caption}</span>
  </div>
</header>

<style>
  .hero {
    display: grid;
    gap: 32px;
    padding-top: clamp(48px, 8vw, 100px);
    padding-bottom: clamp(48px, 8vw, 100px);
  }

  .hero-text {
    display: flex;
    flex-direction: column;
    gap: 24px;
    max-width: 900px;
  }

  .hero-badge {
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    background: var(--color-accent);
    padding: 5px 10px;
    border: var(--border-thin);
    width: fit-content;
    max-width: 100%;
  }

  .hero-h1 {
    display: flex;
    flex-direction: column;
    font-size: clamp(40px, 9vw, 120px);
    font-weight: 900;
    text-transform: uppercase;
    line-height: 0.94;
    letter-spacing: -0.04em;
  }

  .hero-h1 .outline {
    -webkit-text-stroke: 2px var(--color-ink);
    color: var(--color-cream);
  }

  .hero-body {
    font-size: clamp(16px, 1.8vw, 19px);
    font-weight: 500;
    line-height: 1.6;
    max-width: 560px;
    border-left: 4px solid var(--color-ink);
    padding-left: 16px;
  }

  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    row-gap: 18px;
  }

  .cta {
    padding: 16px 28px;
    font-weight: 800;
    text-transform: uppercase;
    text-decoration: none;
    text-align: center;
    border: var(--border);
  }

  .cta-primary {
    background: var(--color-ink);
    color: var(--color-cream);
    box-shadow: 6px 6px 0 var(--color-accent);
  }

  .cta-secondary {
    background: var(--color-cream);
    color: var(--color-ink);
    border-left: none;
    box-shadow: 6px 6px 0 var(--color-ink);
    margin-left: 12px;
  }

  .hero-graphic {
    position: relative;
    height: 260px;
    border: var(--border);
  }

  /* Apilados a ancho completo: en móvil dos botones en fila
     desbordaban la sección junto con su sombra dura. */
  @media (max-width: 520px) {
    .hero-ctas {
      flex-direction: column;
      align-items: stretch;
      gap: 18px;
      padding-right: 6px;
    }

    .cta-secondary {
      margin-left: 0;
      border-left: var(--border);
    }
  }

  .hero-graphic-caption {
    position: absolute;
    right: 12px;
    bottom: 12px;
    background: var(--color-cream);
    border: var(--border-thin);
    padding: 4px 10px;
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    max-width: calc(100% - 24px);
  }
</style>