---
import SectionHeader from './SectionHeader.astro';
import { getContent, tr, type Lang } from '../i18n/ui';
import { interestTags } from '../data/interests';
import InteractiveAvatar from './InteractiveAvatar.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getContent(lang);
---

<section id="about" class="about section">
  <div class="about-text">
    <SectionHeader id="about" eyebrow={t.sec_about} title={t.about_h} subtitle={t.about_body} />

    <div class="tags">
      {interestTags.map((tag) => (
        <span class="tag">{tr(tag, lang)}</span>
      ))}
    </div>
  </div>

  <div class="about-avatar-container">
    <InteractiveAvatar alt={t.about_photo_alt} />
  </div>
</section>

<style>
  .about {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: clamp(24px, 5vw, 56px);
    align-items: start;
  }

  .about-text .tags {
    display: flex;
    flex-wrap: wrap;
    margin: -1px 0 0 -1px;
  }

  .tag {
    font-family: var(--font-mono);
    font-size: 12.5px;
    font-weight: 700;
    text-transform: uppercase;
    padding: 8px 14px;
    border: var(--border-thin);
    margin: -1px 0 0 -1px;
  }

  .about-avatar-container {
    position: relative;
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  @media (max-width: 768px) {
    .about {
      grid-template-columns: 1fr;
    }
  }
</style>
